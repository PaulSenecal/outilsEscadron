{
  "rules": {
    "salles": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hote').val() === auth.uid) || data.child('hote').val() === auth.uid || (!newData.exists() && data.child('cree').val() < now - 21600000))",
        ".validate": "$code.matches(/^[0-9]{4}$/) && newData.hasChildren(['hote', 'cree', 'etat'])",
        "joueurs": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && root.child('salles/' + $code + '/hote').exists()",
            ".validate": "newData.hasChildren(['nom'])",
            "nom": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "$autre": {
              ".validate": false
            }
          }
        },
        "reponses": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && root.child('salles/' + $code + '/etat').val() === 'question' && root.child('salles/' + $code + '/joueurs/' + $uid).exists() && (!data.exists() || data.child('rang').val() !== root.child('salles/' + $code + '/rang').val())",
            ".validate": "newData.hasChildren(['rang', 'choix', 't']) && newData.child('rang').val() === root.child('salles/' + $code + '/rang').val() && newData.child('t').val() === now"
          }
        }
      }
    },
    "jo": {
      "$code": {
        ".read": "auth != null && data.child('proprio').val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('proprio').val() === auth.uid) || (data.child('proprio').val() === auth.uid && (!newData.exists() || newData.child('proprio').val() === auth.uid)))",
        ".validate": "$code.matches(/^[A-Z0-9]{8}$/) && newData.hasChildren(['proprio', 'cree'])",
        "infos": {
          ".read": "auth != null && root.child('jo/' + $code + '/juges/' + auth.uid).exists()"
        },
        "demandes": {
          "$uid": {
            ".read": "auth != null && $uid === auth.uid",
            ".write": "auth != null && $uid === auth.uid && root.child('jo/' + $code + '/proprio').exists() && !root.child('jo/' + $code + '/juges/' + auth.uid).exists()",
            ".validate": "newData.hasChildren(['nom', 't']) && newData.child('t').val() === now",
            "nom": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
            },
            "souhait": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "t": {
              ".validate": true
            },
            "$autre": {
              ".validate": false
            }
          }
        },
        "juges": {
          "$uid": {
            ".read": "auth != null && $uid === auth.uid"
          }
        },
        "resultats": {
          ".read": "auth != null && root.child('jo/' + $code + '/juges/' + auth.uid).exists()",
          "$ep": {
            "$eq": {
              ".write": "auth != null && (root.child('jo/' + $code + '/juges/' + auth.uid).child('tout').val() === true || root.child('jo/' + $code + '/juges/' + auth.uid).child('epreuves/' + $ep).val() === true)",
              ".validate": "$ep.matches(/^(c400|vortex|poi|poc|co|relais)$/) && $eq.matches(/^[a-z0-9]{1,8}$/)"
            }
          }
        },
        "bonus": {
          ".read": "auth != null && root.child('jo/' + $code + '/juges/' + auth.uid).exists()",
          "$eq": {
            ".write": "auth != null && (root.child('jo/' + $code + '/juges/' + auth.uid).child('tout').val() === true || root.child('jo/' + $code + '/juges/' + auth.uid).child('epreuves/bonus').val() === true)",
            ".validate": "$eq.matches(/^[a-z0-9]{1,8}$/)"
          }
        }
      }
    },
    "quiz": {
      ".read": true,
      "questions": {
        "$id": {
          ".write": "auth != null && (root.child('admins/' + auth.uid).val() === true || (auth.token.email_verified === true && root.child('editeurs/' + auth.token.email.toLowerCase().replace('.', ',')).exists()))",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['question', 'category', 'answers'])",
          "question": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "category": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "image": {
            ".validate": "newData.isString() && newData.val().length <= 600000"
          },
          "multiCorrect": {
            ".validate": "newData.isBoolean()"
          },
          "isNew": {
            ".validate": "newData.isBoolean()"
          },
          "ordre": {
            ".validate": "newData.isNumber()"
          },
          "answers": {
            "$i": {
              ".validate": "$i.matches(/^[0-5]$/) && newData.hasChildren(['text', 'correct'])",
              "text": {
                ".validate": "newData.isString() && newData.val().length <= 300"
              },
              "correct": {
                ".validate": "newData.isBoolean()"
              },
              "$autre": {
                ".validate": false
              }
            }
          },
          "modifie": {
            ".validate": "newData.hasChildren(['nom', 't']) && newData.child('t').val() === now",
            "nom": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "t": {
              ".validate": true
            },
            "$autre": {
              ".validate": false
            }
          },
          "$autre": {
            ".validate": false
          }
        }
      },
      "categories": {
        ".write": "auth != null && (root.child('admins/' + auth.uid).val() === true || (auth.token.email_verified === true && root.child('editeurs/' + auth.token.email.toLowerCase().replace('.', ',')).exists()))",
        "$id": {
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['label', 'color'])",
          "label": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          },
          "color": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "ordre": {
            ".validate": "newData.isNumber()"
          },
          "$autre": {
            ".validate": false
          }
        }
      },
      "$autre": {
        ".validate": false
      }
    },
    "editeurs": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$cle": {
        ".read": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase().replace('.', ',') === $cle",
        ".validate": "newData.hasChildren(['nom', 'email']) && newData.child('email').val().toLowerCase().replace('.', ',') === $cle",
        "nom": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "ajoute": {
          ".validate": "newData.val() === now"
        },
        "$autre": {
          ".validate": false
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    }
  }
}
